{
  "name": "data-gateway",
  "description": "Exposes endpoints to retrieve data",
  "version": "0.0.0",
  "homepage": "",
  "private": true,
  "main": "src",
  "keywords": [
    "feathers"
  ],
  "author": {
    "name": "Jorge de los Santos",
    "email": "tebayoso@gmail.com"
  },
  "contributors": [],
  "bugs": {},
  "directories": {
    "lib": "src",
    "test": "test/",
    "config": "config/"
  },
  "engines": {
    "node": "^16.0.0",
    "npm": ">= 8.0.0"
  },
  "scripts": {
    "test": "npm run compile && npm run jest",
    "lint": "eslint src --config .eslintrc.json --ext .ts --fix",
    "dev": "DEBUG=*,-express:*,-body-parser:* NODE_ENV=development ts-node-dev --no-notify src",
    "start": "npm run compile && pm2 start ecosystem.config.js",
    "jest": "jest  --forceExit --detectOpenHandles",
    "test:lint": "eslint \\\"src/**/*.{js,jsx,ts,tsx}\\\"",
    "test:prettier": "prettier --check '{src,test}/**/*.{js,jsx,ts,tsx}' '*.{js,json}'",
    "test:all": "npm run test:prettier && npm run test:lint && npm test",
    "compile": "shx rm -rf lib/ && tsc",
    "prettier:format": "prettier --write --ignore-unknown '{src,test}/**/*.{js,jsx,ts,tsx}' '*.{js,json}'",
    "commit:check": "yarn commitlint --edit $1",
    "docker:build": "export $(xargs < .env) && docker build --build-arg PM2_PUBLIC_KEY --build-arg PM2_SECRET_KEY -t data-gateway ..",
    "docker:tag": "docker tag data-gateway:latest ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/data-gateway:latest",
    "docker:push": "docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/data-gateway:latest",
    "cluster:update": "aws ecs update-service --region ${AWS_REGION} --service ${DATA_GATEWAY_CLUSTER} --cluster main --force-new-deployment --profile ${AWS_PROFILE}"
  },
  "standard": {
    "env": [
      "jest"
    ],
    "ignore": []
  },
  "types": "lib/",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.15.0",
    "@aws-sdk/client-kinesis": "^3.18.0",
    "@aws-sdk/client-sqs": "^3.18.0",
    "@aws-sdk/credential-provider-ini": "^3.13.1",
    "@aws-sdk/credential-provider-sso": "^3.13.1",
    "@aws-sdk/node-http-handler": "^3.13.1",
    "@aws-sdk/types": "^3.13.1",
    "@aws-sdk/util-dynamodb": "^3.16.0",
    "@elastic/elasticsearch": "7.12.0",
    "@feathersjs/configuration": "^4.5.11",
    "@feathersjs/errors": "^4.5.11",
    "@feathersjs/express": "^4.5.11",
    "@feathersjs/feathers": "^4.5.11",
    "@feathersjs/socketio": "^4.5.11",
    "@feathersjs/transport-commons": "^4.5.11",
    "@giuseppecampanelli/medium-api": "^1.0.0",
    "@hapi/joi": "^15.1.1",
    "@opensearch-project/opensearch": "^2.0.0",
    "@sentry/node": "^7.11.0",
    "@sentry/tracing": "^7.11.0",
    "@unmarshal/sdk": "^1.0.3",
    "agentkeepalive": "^4.1.4",
    "assert": "^2.0.0",
    "aws-sdk": "^2.935.0",
    "cognito-express": "^2.0.18",
    "compression": "^1.7.4",
    "cookie": "^0.4.0",
    "cors": "^2.8.5",
    "dotenv": "^9.0.2",
    "feathers-memory": "^4.1.0",
    "feathers-sequelize": "^6.2.0",
    "feathers-sync": "^2.3.0",
    "graphql": "^15.5.0",
    "graphql-tag": "^2.12.4",
    "helmet": "^4.5.0",
    "ioredis": "^4.27.7",
    "joi-extract-type": "^15.0.8",
    "lodash": "^4.17.21",
    "moment": "^2.29.1",
    "neo4j-driver": "^4.4.1",
    "pg": "^8.6.0",
    "pluralize": "^8.0.0",
    "sequelize": "^6.6.2",
    "serve-favicon": "^2.5.0",
    "underscore": "^1.12.1",
    "uuid": "^8.3.2",
    "web3": "^1.3.5",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@types/bluebird": "^3.5.34",
    "@types/compression": "^1.7.0",
    "@types/cookie": "^0.4.0",
    "@types/cors": "^2.8.10",
    "@types/jest": "^26.0.22",
    "@types/lodash": "^4.14.169",
    "@types/node": "^14.18.26",
    "@types/pluralize": "^0.0.29",
    "@types/serve-favicon": "^2.5.2",
    "@types/uuid": "^8.3.0",
    "@types/validator": "^10.11.3",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "@typescript-eslint/typescript-estree": "^4.31.2",
    "axios": "^0.33.0",
    "eslint": "^7.25.0",
    "eslint-config-prettier": "^8.3.0",
    "jest": "^26.6.3",
    "lint-staged": "^11.0.0",
    "prettier": "^2.2.1",
    "shx": "^0.3.3",
    "ts-jest": "^26.5.5",
    "ts-node-dev": "^1.1.6",
    "typescript": "^4.2.4"
  },
  "lint-staged": {
    "*": "npm run prettier:format"
  }
}
